<Window x:Class="Voin_Patrusheva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Voin_Patrusheva"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border
          BorderBrush="Black"
          BorderThickness="1"
          Margin="10"
          Background="White"
          MouseDown="AttackHard">
            <Grid>
                <Image
                 Margin="10,10,10,121" 
                 Source="Images\hard_dospexi.jpg"/>
                <Label  
                    Content="Введите урон" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    FontWeight="Bold" 
                    Margin="0,0,0,70"/>
                <Label 
                    Name="playerHealthLD" 
                    Content="Жизненные показатели: 100" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom"  
                    Margin="0,0,0,39"/>
                <TextBox
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom"
                    Margin="125,0,0,70" 
                    Height="26" 
                    Width="243"
                    x:Name="HDYron"/>
            </Grid>
        </Border>
        <Border BorderBrush="Black" 
                BorderThickness="1" 
                Margin="10" 
                Background="#FFFDFDFD" 
                Grid.Column="1" 
                MouseDown="AttackEnemy">
            <Grid>
                <Image Name="emptyImage" 
                       Margin="10,10,10,118" 
                       Source="Images\legkie_dospexi.jpg"/>
                <Label 
                    Content="Введите урон:" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    FontWeight="Bold" 
                    Margin="0,0,0,69"/>
                <TextBox
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom"
                    Margin="125,0,0,69" 
                    Height="26" 
                    Width="243"
                    x:Name="LDYron"/>
                <Label 
                    Name="playerHealthHD" 
                    Content="Жизненные показатели: 100" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom"  
                    Margin="0,0,0,39"/>
            </Grid>
        </Border>
    </Grid>
</Window>
